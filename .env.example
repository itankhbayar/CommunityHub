# Copy to .env before running `docker compose up`.
# Every variable the stack reads is listed here. No real secrets belong in this file.

# ---- Postgres -------------------------------------------------------------
POSTGRES_USER=communityhub
POSTGRES_PASSWORD=communityhub
POSTGRES_DB=communityhub
# Host-side port only. Change this if you already run Postgres locally on 5432 —
# containers always talk to each other on 5432 regardless of this value.
POSTGRES_PORT=5432

# ---- Ports (host side) ----------------------------------------------------
API_PORT=4000
WEB_PORT=3000

# ---- Backend --------------------------------------------------------------
# Used by the API container. When running the API outside docker, point the
# host at localhost instead of the `db` service name:
#   postgresql://communityhub:communityhub@localhost:5432/communityhub?schema=public
DATABASE_URL=postgresql://communityhub:communityhub@db:5432/communityhub?schema=public

# e2e tests need a real Postgres (the RSVP capacity test is meaningless against
# a mock). They run against their own database so they can truncate freely
# without destroying seeded demo data. Optional: defaults to DATABASE_URL with
# `_test` appended to the database name, created automatically on first run.
# TEST_DATABASE_URL=postgresql://communityhub:communityhub@localhost:5432/communityhub_test?schema=public

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:3000

# Generate a real value for anything non-local: `openssl rand -base64 48`
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Set true when serving over HTTPS so auth cookies carry the Secure flag.
COOKIE_SECURE=false

# Leave unset for same-origin setups (compose, localhost) — access cookies stay
# SameSite=Lax and refresh cookies SameSite=Strict, which blocks CSRF.
# Set to `none` ONLY when web and API are on different domains (e.g. Vercel
# frontend + hosted API): Lax/Strict cookies set by a cross-site response are
# discarded by the browser, so login silently fails to persist. `none` forces
# Secure on and gives up SameSite's CSRF protection — see README.
# COOKIE_SAMESITE=none

# ---- Frontend -------------------------------------------------------------
# Read in the browser, so it must be reachable from the host, not from inside compose.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Copy to .env before running `docker compose up`.
# Every variable the stack reads is listed here. No real secrets belong in this file.

# ---- Postgres -------------------------------------------------------------
POSTGRES_USER=communityhub
POSTGRES_PASSWORD=communityhub
POSTGRES_DB=communityhub
# Host-side port only. Change this if you already run Postgres locally on 5432 —
# containers always talk to each other on 5432 regardless of this value.
POSTGRES_PORT=5432

# ---- Ports (host side) ----------------------------------------------------
API_PORT=4000
WEB_PORT=3000

# ---- Backend --------------------------------------------------------------
# Used by the API container. When running the API outside docker, point the
# host at localhost instead of the `db` service name:
#   postgresql://communityhub:communityhub@localhost:5432/communityhub?schema=public
DATABASE_URL=postgresql://communityhub:communityhub@db:5432/communityhub?schema=public

# Hosted Postgres (Supabase) uses a different shape — see README "Deploying":
#   postgresql://postgres.<ref>:<pw>@<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=./certs/supabase-ca.crt
# Session pooler (port 5432), NOT db.<ref>.supabase.co — that resolves to IPv6
# only, and NOT port 6543, whose transaction mode complicates the RSVP row
# locks. sslmode is required because Supabase refuses cleartext while pg reads
# a missing sslmode as no-TLS; bare `require` fails too, since pg 8.x aliases
# it to verify-full and Supabase signs with its own root CA. That CA ships at
# backend/certs/supabase-ca.crt (public, safe to commit) — pinning it makes the
# connection authenticated rather than merely encrypted.

# e2e tests need a real Postgres (the RSVP capacity test is meaningless against
# a mock). They run against their own database so they can truncate freely
# without destroying seeded demo data. Optional: defaults to DATABASE_URL with
# `_test` appended to the database name, created automatically on first run.
# TEST_DATABASE_URL=postgresql://communityhub:communityhub@localhost:5432/communityhub_test?schema=public

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:3000

# Generate a real value for anything non-local: `openssl rand -base64 48`
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Set true when serving over HTTPS so auth cookies carry the Secure flag.
COOKIE_SECURE=false

# Number of reverse proxies in front of the API. Decides what client IP the
# rate limiter sees, and both mistakes are silent:
#   too low  -> every request looks like it came from the proxy, so one bucket
#               is shared by the whole internet and the limiter locks everyone
#               out at once
#   too high -> X-Forwarded-For is caller-controlled, so a fresh header per
#               request means a fresh bucket per request and no limit at all
# 0 is right for compose, where the browser reaches the API directly. Render
# and Vercel terminate TLS at one hop: set 1 there.
TRUST_PROXY=0

# Leave unset for same-origin setups (compose, localhost) — access cookies stay
# SameSite=Lax and refresh cookies SameSite=Strict, which blocks CSRF.
# Set to `none` ONLY when web and API are on different domains (e.g. Vercel
# frontend + hosted API): Lax/Strict cookies set by a cross-site response are
# discarded by the browser, so login silently fails to persist. `none` forces
# Secure on and gives up SameSite's CSRF protection — see README.
# COOKIE_SAMESITE=none

# ---- Email ----------------------------------------------------------------
# Under compose these are set for you and point at the bundled Mailpit
# container: nothing is delivered, and every message is readable at
# http://localhost:8025. No account or API key is needed to run this project.
#
# Leaving both BREVO_API_KEY and SMTP_HOST blank DISABLES email: messages are
# written to the API log, links and all, instead of being sent. That is the
# right mode for the e2e suite and for running the API on the host, where
# compose's `mailpit` hostname does not resolve and every send would be a DNS
# timeout. To reach the bundled Mailpit from a host-side dev server, use
# SMTP_HOST=localhost with SMTP_PORT=1025.
#
# Uncommenting either block under compose overrides the Mailpit default and
# sends for real — useful for checking credentials before deploying, but a
# registration then mails whatever address was typed. Use your own.
#
# Brevo is the reference provider (chosen because it verifies a single sender
# address, so no domain of your own is needed; free tier is 300/day). It offers
# two ways in, and they want DIFFERENT credentials from neighbouring tabs of
# the same page. Pick one:
#
# 1. HTTPS API — "SMTP & API" -> "API Keys". Required on hosts that block
#    outbound SMTP ports, which includes Render's free tier; port 443 is not
#    blocked. Takes precedence when both are set.
# BREVO_API_KEY=xkeysib-...
#
# 2. SMTP — SMTP_USER is the account login email and SMTP_PASSWORD is an SMTP
#    key generated under "SMTP & API" -> "SMTP", NOT the API key above and not
#    the account password. Port 465 is treated as implicit TLS; anything else
#    upgrades via STARTTLS.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=

# Must be an address Brevo has verified under Senders, or mail is rejected no
# matter how correct the credentials above are. The default below is a .local
# domain that does not resolve — fine for Mailpit, never accepted by a provider.
MAIL_FROM=CommunityHub <no-reply@communityhub.local>

# Where password-reset and verification links point — the web app, not the API.
APP_URL=http://localhost:3000

# Host port for the Mailpit web UI; change if 8025 is taken.
MAILPIT_UI_PORT=8025

# ---- Frontend -------------------------------------------------------------
# Read in the browser, so it must be reachable from the host, not from inside compose.
NEXT_PUBLIC_API_URL=http://localhost:4000
